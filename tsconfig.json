// "module"/"moduleResolution" = Node16, not CommonJS/node.
//
// The old value ("node") became `node10`, which TypeScript 6 flags as
// deprecated (TS5107) and 7 removes. Because VS Code ships its own TypeScript
// — newer than the one in devDependencies — the error shows up ONLY in the
// editor while `npm run typecheck` passes. Confusing symptom, silly cause.
//
// Node16 still emits CommonJS (there is no "type": "module" in package.json),
// so nothing changes at runtime: relative imports keep working without
// extensions.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false,
    "lib": ["ES2022"],
    "types": ["node", "bun"]
  },
  "include": ["src/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "dist", "data"]
}
