{
  "name": "magic-world-analytics",
  "version": "1.0.0",
  "private": true,
  "description": "First-party analytics sink for the Magic World audiobook app — receives events from ANALYTICS_ENDPOINT and shows the pre-purchase funnel that RevenueCat does not see.",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:bun": "bun --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "start:bun": "bun src/server.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:bun": "bun scripts/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:dashboard": "node scripts/check-dashboard.mjs"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
